/* ============ R24 首页改版：任务流首页 ============ */
/* 结构：头部卡 → Hero 今日学习（唯一主行动，三态）→ 学习进度卡（并行批次）→
   宠物+拍照收词并排 → 家庭榜（唯一切换账号入口）→ 工具格 → 一键初始化（弱化）。
   规范：字号五档 40 / 34 / 30 / 26 / 22；卡片强调统一为左色条；动画只做入场一次。 */

/* ---- 头部卡（R18 保留精简） ---- */
.head { margin-bottom: 24rpx; }
.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.head-slogan {
  color: #07c160;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.head-help {
  min-width: 108rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #eefaf2;
  color: #07c160;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.head-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.head-name-wrap { display: flex; align-items: center; min-width: 0; }
.head-account-tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  background: #eefaf2;
  color: #07c160;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}
.head-name { font-size: 40rpx; font-weight: bold; }
.head-streak {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #fff7e6;
  color: #f59a23;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}
.head-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.head-desc {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  color: #999;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.head-switch { color: #576b95; font-size: 26rpx; flex-shrink: 0; }

/* ---- R24 Hero：今日学习主卡（三态） ---- */
.hero {
  background: linear-gradient(135deg, #07c160 0%, #05a552 100%);
  border-radius: 24rpx;
  padding: 44rpx 36rpx 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(7, 193, 96, 0.32);
  animation: heroIn .36s ease-out;
}
@keyframes heroIn {
  from { opacity: 0; transform: translateY(-14rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.hero-title { font-size: 40rpx; font-weight: bold; }
.hero-tasks { margin-top: 22rpx; }
.hero-task {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 6rpx 0;
}
.hero-task-icon { margin-right: 12rpx; font-size: 30rpx; }
.hero-task-sub { font-size: 22rpx; opacity: .8; margin-left: 8rpx; font-weight: 400; }
.hero-est {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: .85;
}
.hero-btn {
  margin-top: 30rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #fff;
  color: #07c160;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-btn:active { opacity: .88; }
.hero-btn-play { margin-right: 14rpx; font-size: 28rpx; }
/* done / graduated 态的次级按钮：白描边样式 */
.hero-btn.secondary {
  margin-top: 26rpx;
  height: 84rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
}
.hero-cele { font-size: 80rpx; line-height: 1; margin-bottom: 16rpx; }
.hero-tomorrow { margin-top: 14rpx; font-size: 26rpx; opacity: .9; }

/* ---- R24 学习进度卡：并行批次摘要 ---- */
.prog-card { margin-bottom: 24rpx; border-left: 8rpx solid #07c160; }
.prog-head {
  display: flex;
  align-items: baseline;
}
.prog-title { font-size: 34rpx; font-weight: bold; }
.prog-count {
  margin-left: 14rpx;
  color: #07c160;
  font-size: 24rpx;
  font-weight: 600;
  background: #eefaf2;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.prog-go {
  margin-left: auto;
  color: #576b95;
  font-size: 26rpx;
}
.prog-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.prog-row-main { flex: 1; min-width: 0; }
.prog-row-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.prog-row-batch { font-size: 28rpx; font-weight: 600; color: #333; }
.prog-row-flag {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #eefaf2;
  color: #07c160;
  font-weight: 600;
}
.prog-row-flag.od { background: #fff0ef; color: #e64340; }
.prog-row-flag.cons { background: #f1edff; color: #7a5af5; }
.prog-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.prog-bar-fill {
  height: 100%;
  background: #07c160;
  border-radius: 8rpx;
  transition: width .32s ease-out;
}
.prog-row.od .prog-bar-fill { background: #e64340; }
.prog-row-side { flex-shrink: 0; margin-left: 20rpx; text-align: right; }
.prog-day { color: #666; font-size: 24rpx; }
.prog-final { color: #999; font-size: 22rpx; margin-top: 6rpx; }

/* ---- R24 宠物 + 拍照收词并排卡 ---- */
.duo-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}
.duo-pet {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding-right: 24rpx;
}
.duo-pet-emoji {
  font-size: 72rpx;
  line-height: 1;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.duo-pet-emoji.bounce { animation: petJump .6s cubic-bezier(.34, 1.56, .64, 1); }
@keyframes petJump {
  0% { transform: translateY(0); }
  40% { transform: translateY(-24rpx) scale(1.08); }
  100% { transform: translateY(0); }
}
.duo-pet-main { flex: 1; min-width: 0; }
.duo-pet-title { font-size: 28rpx; font-weight: 600; }
.duo-pet-bar {
  height: 12rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 10rpx 0 8rpx;
}
.duo-pet-fill {
  height: 100%;
  background: #07c160;
  border-radius: 8rpx;
  transition: width .32s ease-out;
}
.duo-pet-next { color: #999; font-size: 22rpx; }
.duo-photo {
  flex-shrink: 0;
  width: 176rpx;
  border-left: 2rpx solid #f2f2f2;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.duo-photo-icon { font-size: 52rpx; line-height: 1; }
.duo-photo-name { font-size: 28rpx; font-weight: 600; margin-top: 10rpx; color: #576b95; }
.duo-photo-sub { font-size: 20rpx; color: #bbb; margin-top: 4rpx; }

/* ---- R18 家庭榜：名次 + chip 化，唯一切换账号入口 ---- */
.family-card { margin-bottom: 24rpx; }
.family-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 6rpx;
}
.family-title { font-size: 34rpx; font-weight: 600; }
.family-note { color: #999; font-size: 22rpx; }
.family-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}
.family-row:last-child { border-bottom: none; }
.family-rank {
  width: 56rpx;
  text-align: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.family-pet { font-size: 44rpx; margin-right: 16rpx; flex-shrink: 0; }
.family-info { flex: 1; min-width: 0; }
.family-name { font-size: 30rpx; color: #333; }
.family-sub { color: #07c160; font-size: 22rpx; margin-top: 4rpx; }
.family-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.family-chip {
  background: #f5f6f8;
  color: #666;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
}
.family-chip.fire { background: #fff7e6; color: #f59a23; font-weight: 600; }
.family-zero { color: #bbb; font-size: 22rpx; }
.family-row.me .family-name { color: #07c160; font-weight: 600; }

/* ---- R24 工具格：错词本 / 词库 / 教材总览 / 学习记录 ---- */
.tools {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.tool {
  position: relative;
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 10rpx 26rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.tool:active { opacity: .88; }
.tool-icon { font-size: 48rpx; line-height: 1; }
.tool-name { font-size: 26rpx; color: #333; margin-top: 12rpx; font-weight: 600; }
.tool-badge {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  background: #e64340;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
}

/* ---- 一键初始化（低频危险操作，视觉弱化置底） ---- */
.account-tools { margin-bottom: 24rpx; }
.account-tools-title { font-size: 30rpx; font-weight: 600; color: #666; }
.account-tools-sub { color: #999; font-size: 24rpx; margin-top: 8rpx; }
.account-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.account-action { flex: 1; margin: 0; color: #07c160; background: #eefaf2; font-size: 28rpx; }
.account-action.danger { color: #e64340; background: #fff0ef; }
