<view class="container">
  <!-- R18 头部卡：原 hero + 账号卡合并，零顶部留白；口号 + 当前账号 + streak + 切换提示 + 「?」指南占位 -->
  <view class="card head">
    <view class="head-top">
      <view class="head-slogan">21天记忆法 · AI 拍照收词与拓展</view>
      <view class="head-help" bindtap="showGuide">?</view>
    </view>
    <view class="head-main">
      <view class="head-name">{{accountName}}</view>
      <view class="head-streak" wx:if="{{streak > 0}}">🔥 连续 {{streak}} 天</view>
    </view>
    <view class="head-bottom">
      <view class="head-desc">{{accountDesc}}</view>
      <view class="head-switch" bindtap="goFamily">切换账号 ▸</view>
    </view>
  </view>

  <!-- R16-B 复习优先引导：有到期任务时紧随头部卡置顶（软引导不拦截）。
       R19：todayItems=0（到期批均为遗忘池已空的空轮）时不显示，避免「今日有 0 词」文案。
       R21-B：追加未来两日排期预告（损失厌恶式提醒） -->
  <view class="due-banner" wx:if="{{dueCount > 0 && todayItems > 0}}" bindtap="goReview">
    <view class="due-banner-icon">🔁</view>
    <view class="due-banner-main">
      <view class="due-banner-title">今日有 {{todayItems}} 词到期复习（{{dueCount}} 批）</view>
      <view class="due-banner-sub">先复习，再学新词，记得更牢</view>
      <view class="due-banner-fc" wx:if="{{forecastText}}">接下来：{{forecastText}}</view>
    </view>
    <view class="due-banner-go">▸</view>
  </view>

  <view class="menu">
    <view class="menu-btn new" bindtap="goNew">
      <view class="menu-icon">📖</view>
      <view class="menu-name">新单词</view>
      <!-- R21-B：下一批预告（拍照批优先/教材批号词数）+ 全书进度微条 -->
      <view class="menu-desc">{{newPreview}}</view>
      <view class="menu-bar" wx:if="{{overviewPct > 0}}"><view class="menu-bar-fill" style="width: {{overviewPct}}%;"></view></view>
    </view>
    <view class="menu-btn review" bindtap="goReview">
      <view class="menu-icon">🔁</view>
      <view class="menu-name">复习</view>
      <view class="menu-desc">{{reviewDesc}}</view>
      <!-- R21-B：未来两日排期（今天有任务时显示，制造「明天也会痛」的预期） -->
      <view class="menu-sub" wx:if="{{todayItems > 0 && forecastText}}">{{forecastText}}</view>
    </view>
  </view>

  <!-- R12 宠物养成：啾啾随累计已学词数成长（点击互动） -->
  <view class="card pet-card" wx:if="{{pet}}" bindtap="tapPet">
    <view class="pet-emoji {{petBounce ? 'bounce' : ''}}">{{pet.emoji}}</view>
    <view class="pet-main">
      <view class="pet-title">啾啾 · {{pet.name}} <text class="pet-learned">已陪学 {{pet.learned}} 词</text></view>
      <view class="pet-bar"><view class="pet-fill" style="width: {{pet.pct}}%;"></view></view>
      <view class="pet-next" wx:if="{{!pet.maxed}}">距离 {{pet.nextEmoji}} {{pet.nextName}} 还差 {{pet.remaining}} 词</view>
      <view class="pet-next" wx:else>已是传说形态，词海无涯 🎉</view>
    </view>
  </view>

  <view class="card photo" bindtap="goPhoto">
    <view class="photo-left">
      <view class="photo-title">📷 拍照收词</view>
      <view class="photo-desc text-muted">拍课本 / 练习册，AI 识别生词并收录，优先学习</view>
    </view>
    <view class="photo-go">▸</view>
  </view>

  <view class="card wrong" bindtap="goWrong">
    <view class="wrong-left">
      <view class="wrong-title">📕 错词本</view>
      <view class="wrong-desc text-muted">复习答错的单词集中在这里，会了就移出</view>
    </view>
    <view class="wrong-badge {{wrongCount > 0 ? 'has' : ''}}">{{wrongCount}}</view>
  </view>

  <view class="card progress" bindtap="goOverview">
    <view class="progress-top">
      <view class="progress-title">🗺 教材进度</view>
      <view class="progress-count">全书 {{overviewCount}} 批 · {{totalWords}} 词</view>
    </view>
    <view class="progress-bar"><view class="progress-fill" style="width: {{overviewPct}}%;"></view></view>
    <view class="progress-meta">
      <view class="progress-pct">{{overviewPct}}% · 已学 {{learned}} 词</view>
      <view class="progress-link">查看教材总览 ▸</view>
    </view>
  </view>

  <view class="card stats">
    <view class="stats-row">
      <view class="stats-item">
        <view class="stats-num">{{learned}}</view>
        <view class="stats-label">已学单词</view>
      </view>
      <view class="stats-item tappable" bindtap="goBank">
        <view class="stats-num">{{totalWords}}</view>
        <view class="stats-label">词库总量 ▸</view>
      </view>
    </view>
    <view class="history-link" bindtap="goHistory">查看学习记录（日期与内容）→</view>
  </view>

  <!-- R18 家庭榜重构：名次 + chip 化数据，首页唯一的切换账号入口 -->
  <view class="card family-card" wx:if="{{family.length > 1}}">
    <view class="family-head">
      <view class="family-title">🏠 家庭榜</view>
      <view class="family-note">点按切换账号</view>
    </view>
    <view class="family-row {{f.id === currentAccountId ? 'me' : ''}}"
          wx:for="{{family}}" wx:key="id" bindtap="pickAccount" data-id="{{f.id}}">
      <text class="family-rank">{{f.rank}}</text>
      <text class="family-pet">{{f.petEmoji}}</text>
      <view class="family-info">
        <view class="family-name">{{f.name}}</view>
        <view class="family-sub" wx:if="{{f.id === currentAccountId}}">当前使用</view>
      </view>
      <view class="family-right">
        <block wx:if="{{f.learned > 0}}">
          <text class="family-chip">{{f.learned}} 词</text>
          <text class="family-chip fire" wx:if="{{f.streak > 0}}">🔥 {{f.streak}} 天</text>
        </block>
        <text class="family-zero" wx:else>还没开始</text>
      </view>
    </view>
  </view>
</view>
