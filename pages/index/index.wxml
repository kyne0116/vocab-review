<view class="container">
  <!-- R18 头部卡：口号 + 当前账号 + streak + 切换提示（保留精简） -->
  <view class="card head">
    <view class="head-top">
      <view class="head-slogan">21天记忆法 · AI 拍照收词与拓展</view>
      <view class="head-help" bindtap="showGuide">使用指南</view>
    </view>
    <view class="head-main">
      <view class="head-name-wrap">
        <view class="head-account-tag">当前账号</view>
        <view class="head-name">{{accountName}}</view>
      </view>
      <view class="head-streak" wx:if="{{streak > 0}}">🔥 连续 {{streak}} 天</view>
    </view>
    <view class="head-bottom">
      <view class="head-desc">{{accountDesc}}</view>
      <view class="head-switch" bindtap="goFamily">切换账号 ▸</view>
    </view>
  </view>

  <!-- R24 Hero：今日学习（唯一主行动，三态） -->
  <view class="hero" wx:if="{{mission}}">
    <!-- ☀️ 待开始：任务构成 + 预计时长 + 主按钮 -->
    <block wx:if="{{mission.state === 'todo'}}">
      <view class="hero-title">☀️ 今日学习</view>
      <view class="hero-tasks">
        <view class="hero-task" wx:if="{{mission.hasReview}}">
          <text class="hero-task-icon">🔁</text>
          <text>复习 {{mission.reviewWords}} 词</text>
          <text class="hero-task-sub" wx:if="{{mission.dueCount > 1}}">（{{mission.dueCount}} 批合并）</text>
        </view>
        <view class="hero-task" wx:if="{{mission.hasNew}}">
          <text class="hero-task-icon">📖</text>
          <text>新学 {{mission.newWords}} 词</text>
          <text class="hero-task-sub" wx:if="{{mission.newIsPhoto}}">（拍照批）</text>
          <text class="hero-task-sub" wx:elif="{{mission.newIsManual}}">（手动批）</text>
          <text class="hero-task-sub" wx:else>（第 {{mission.newBatchNo}} 批）</text>
        </view>
      </view>
      <view class="hero-est" wx:if="{{mission.estMin > 0}}">预计约 {{mission.estMin}} 分钟</view>
      <view class="hero-btn" bindtap="goToday">
        <text class="hero-btn-play">▶</text>
        <text>开始今日学习</text>
      </view>
    </block>

    <!-- 🎉 已完成 / 今日无任务：庆祝 + 明日预告 + 错词本自测出口 -->
    <block wx:elif="{{mission.state === 'done'}}">
      <view class="hero-cele">🎉</view>
      <view class="hero-title">{{mission.reviewedToday || mission.learnedToday ? '今日学习已完成' : '今日无待办任务'}}</view>
      <view class="hero-tomorrow" wx:if="{{tomorrowText}}">接下来：{{tomorrowText}}</view>
      <view class="hero-btn secondary" wx:if="{{wrongCount > 0}}" bindtap="goWrong">📕 自由复习错词本（{{wrongCount}} 词）</view>
    </block>

    <!-- 🎓 全部毕业：引导拍照收词扩充词库 -->
    <block wx:else>
      <view class="hero-cele">🎓</view>
      <view class="hero-title">全部毕业！</view>
      <view class="hero-tomorrow">词库已学完、复习全部结业，太棒了</view>
      <view class="hero-btn secondary" bindtap="goPhoto">📷 拍照收词，扩充词库</view>
    </block>
  </view>

  <!-- R24 学习进度卡：并行批次摘要 → 点入时间线明细 -->
  <view class="card prog-card" bindtap="goProgress" wx:if="{{activeCount > 0}}">
    <view class="prog-head">
      <view class="prog-title">📈 学习进度</view>
      <view class="prog-count">并行 {{activeCount}} 批</view>
      <view class="prog-go">查看 ▸</view>
    </view>
    <view class="prog-row {{item.overdue ? 'od' : ''}}" wx:for="{{progressRows}}" wx:key="batchNo">
      <view class="prog-row-main">
        <view class="prog-row-top">
          <text class="prog-row-batch">第 {{item.batchNo}} 批</text>
          <text class="prog-row-flag {{item.overdue ? 'od' : ''}} {{item.consolidating ? 'cons' : ''}}" wx:if="{{item.flag}}">{{item.flag}}</text>
        </view>
        <view class="prog-bar"><view class="prog-bar-fill" style="width: {{item.pct}}%;"></view></view>
      </view>
      <view class="prog-row-side">
        <view class="prog-day">第 {{item.dayN}} 天 · {{item.reviewsDone}}/{{item.rounds}} 轮</view>
        <view class="prog-final">🎓 {{item.finalShort}}</view>
      </view>
    </view>
  </view>

  <!-- R24 宠物（精简一行）+ 拍照收词（特色功能保高位） -->
  <view class="card duo-card">
    <view class="duo-pet" bindtap="tapPet">
      <view class="duo-pet-emoji {{petBounce ? 'bounce' : ''}}">{{pet.emoji}}</view>
      <view class="duo-pet-main">
        <view class="duo-pet-title">啾啾 · {{pet.name}}</view>
        <view class="duo-pet-bar"><view class="duo-pet-fill" style="width: {{pet.pct}}%;"></view></view>
        <view class="duo-pet-next" wx:if="{{!pet.maxed}}">还差 {{pet.remaining}} 词进化</view>
        <view class="duo-pet-next" wx:else>已是传说形态 🎉</view>
      </view>
    </view>
    <view class="duo-photo" bindtap="goPhoto">
      <view class="duo-photo-icon">📷</view>
      <view class="duo-photo-name">拍照收词</view>
      <view class="duo-photo-sub">AI 识别 / 手动录入</view>
    </view>
  </view>

  <!-- R18 家庭榜：名次 + chip 化数据，首页唯一的切换账号入口 -->
  <view class="card family-card" wx:if="{{family.length > 1}}">
    <view class="family-head">
      <view class="family-title">🏠 家庭榜</view>
      <view class="family-note">点按切换账号</view>
    </view>
    <view class="family-row {{f.id === currentAccountId ? 'me' : ''}}"
          wx:for="{{family}}" wx:for-item="f" wx:key="id" bindtap="pickAccount" data-id="{{f.id}}">
      <text class="family-rank">{{f.rank}}</text>
      <text class="family-pet">{{f.petEmoji}}</text>
      <view class="family-info">
        <view class="family-name">{{f.name}}</view>
        <view class="family-sub" wx:if="{{f.id === currentAccountId}}">当前使用</view>
      </view>
      <view class="family-right">
        <block wx:if="{{f.learned > 0}}">
          <text class="family-chip">{{f.learned}} 词</text>
          <text class="family-chip fire" wx:if="{{f.streak > 0}}">🔥 {{f.streak}} 天</text>
        </block>
        <text class="family-zero" wx:else>还没开始</text>
      </view>
    </view>
  </view>

  <!-- R24 工具格：错词本 / 词库 / 教材总览 / 学习记录 -->
  <view class="tools">
    <view class="tool" bindtap="goWrong">
      <view class="tool-icon">📕</view>
      <view class="tool-name">错词本</view>
      <view class="tool-badge {{wrongCount > 0 ? 'has' : ''}}" wx:if="{{wrongCount > 0}}">{{wrongCount}}</view>
    </view>
    <view class="tool" bindtap="goBank">
      <view class="tool-icon">📚</view>
      <view class="tool-name">词库</view>
    </view>
    <view class="tool" bindtap="goOverview">
      <view class="tool-icon">🗂</view>
      <view class="tool-name">教材总览</view>
    </view>
    <view class="tool" bindtap="goHistory">
      <view class="tool-icon">📋</view>
      <view class="tool-name">学习记录</view>
    </view>
  </view>

  <view class="card account-tools">
    <view class="account-tools-title">账号与学习初始化</view>
    <view class="account-tools-sub">清空当前账号，重新开始学习</view>
    <button class="account-action danger" bindtap="resetProgress">一键初始化</button>
  </view>
</view>
