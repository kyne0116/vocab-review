/* 学习模式页样式 */
.head { text-align: center; margin-bottom: 24rpx; }
.head-title { font-size: 36rpx; font-weight: 600; }
.head-info { color: #666; font-size: 26rpx; margin-top: 8rpx; }

/* 模式选择 */
.mode-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.mode-btn {
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.mode-btn:last-child { margin-bottom: 0; }
.mode-btn:active { background: #f0faf4; border-color: #07c160; }
.mode-icon { font-size: 56rpx; }
.mode-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #07c160;
  margin: 12rpx 0 8rpx;
}
.mode-desc { font-size: 26rpx; color: #999; }

/* 模式切换条 */
.mode-bar {
  display: flex;
  margin-bottom: 20rpx;
  padding: 14rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #666;
}
.mode-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
}

/* 工具条 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 30rpx;
}
.toolbar-btns { display: flex; }
.link-btn {
  color: #07c160;
  font-size: 28rpx;
  margin-left: 30rpx;
}

/* 单词条目 */
.list { padding: 10rpx 30rpx; }
.study-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}
.study-item:last-child { border-bottom: none; }
.study-item:active { background: #fafafa; }
.study-idx {
  color: #bbb;
  font-size: 26rpx;
  width: 60rpx;
  padding-top: 6rpx;
  flex-shrink: 0;
}
.study-main { flex: 1; min-width: 0; }
.study-front {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  word-break: break-word;
}
.study-front.cn { font-size: 32rpx; }
.study-phonetic { color: #999; font-size: 26rpx; margin-top: 6rpx; }
.study-phonetic-inline { color: #999; font-size: 26rpx; font-weight: 400; }
.study-back {
  margin-top: 14rpx;
  background: #e8f8ef;
  color: #07c160;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  word-break: break-word;
}
.study-hint {
  margin-top: 10rpx;
  color: #ccc;
  font-size: 24rpx;
}
