/* 学习模式页样式 */
.head { text-align: center; margin-bottom: 24rpx; }
.head-title { font-size: 36rpx; font-weight: 600; }
.head-info { color: #666; font-size: 26rpx; margin-top: 8rpx; }

/* 模式选择 */
.mode-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.mode-btn {
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.mode-btn:last-child { margin-bottom: 0; }
.mode-btn:active { background: #f0faf4; border-color: #07c160; }
.mode-icon { font-size: 56rpx; }
.mode-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #07c160;
  margin: 12rpx 0 8rpx;
}
.mode-desc { font-size: 26rpx; color: #999; }

/* 模式切换条 */
.mode-bar {
  display: flex;
  margin-bottom: 20rpx;
  padding: 14rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #666;
}
.mode-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
}

/* 工具条 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 30rpx;
}
.toolbar-btns { display: flex; }
.link-btn {
  color: #07c160;
  font-size: 28rpx;
  margin-left: 30rpx;
}

/* 单词条目 */
.list { padding: 10rpx 30rpx; }
.study-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}
.study-item:last-child { border-bottom: none; }
.study-item:active { background: #fafafa; }
.study-idx {
  color: #bbb;
  font-size: 26rpx;
  width: 60rpx;
  padding-top: 6rpx;
  flex-shrink: 0;
}
.study-main { flex: 1; min-width: 0; }
.study-front {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  word-break: break-word;
}
.study-front.cn { font-size: 32rpx; }
.study-phonetic { color: #999; font-size: 26rpx; margin-top: 6rpx; }
.study-phonetic-inline { color: #999; font-size: 26rpx; font-weight: 400; }
.study-back {
  margin-top: 14rpx;
  background: #e8f8ef;
  color: #07c160;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  word-break: break-word;
  animation: backPop .28s ease-out; /* R11：翻面弹出 */
}
@keyframes backPop {
  from { transform: scale(.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.study-hint {
  margin-top: 10rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* ---- 行右侧操作区（R10，行结构对齐拍照候选页） ---- */
.study-acts {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.act-btn {
  width: 92rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f2f6f9;
  color: #555;
  font-size: 30rpx;
  box-shadow: 0 5rpx 0 #e1e8ee; /* R11 厚底按钮 */
  transition: transform .18s, box-shadow .18s;
}
.act-btn.txt {
  margin-top: 14rpx;
  background: #e8f8ef;
  color: #07c160;
  font-size: 26rpx;
  box-shadow: 0 5rpx 0 #cdebdb;
}
.act-btn:active { transform: translateY(5rpx); box-shadow: 0 0 0 rgba(0, 0, 0, 0); }

/* ---- 拓展弹层（R10）：半屏底部弹层 ---- */
.link-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 90;
}
.link-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 91;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.link-head {
  display: flex;
  align-items: baseline;
  padding: 28rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f2f2f2;
  position: relative;
}
.link-word { font-size: 40rpx; font-weight: 600; color: #333; }
.link-phon { color: #999; font-size: 26rpx; margin-left: 16rpx; }
.link-close {
  position: absolute;
  right: 24rpx; top: 24rpx;
  color: #999;
  font-size: 32rpx;
  padding: 6rpx 10rpx;
}
.link-body { overflow-y: scroll; padding: 6rpx 30rpx 40rpx; }
.link-body.center { text-align: center; padding: 70rpx 30rpx; }
.link-tip { color: #999; font-size: 28rpx; }
.link-retry { color: #07c160; font-size: 28rpx; margin-top: 24rpx; }
.link-sec { margin-top: 28rpx; }
.link-sec-title { font-size: 28rpx; font-weight: 600; color: #07c160; margin-bottom: 14rpx; }
.link-group { margin-bottom: 18rpx; }
.link-group-pos { color: #999; font-size: 24rpx; margin-bottom: 10rpx; }
.link-rel { display: flex; margin-bottom: 10rpx; }
.link-rel-w { color: #333; font-weight: 600; font-size: 28rpx; margin-right: 16rpx; flex-shrink: 0; }
.link-rel-m { color: #666; font-size: 26rpx; flex: 1; }
.link-syns { display: flex; flex-wrap: wrap; }
.link-syn {
  background: #f2f6f9;
  color: #444;
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
  font-size: 27rpx;
  margin: 0 14rpx 14rpx 0;
}
.link-sent {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed #f0f0f0;
}
.link-sent:last-child { border-bottom: none; }
.link-sent-main { flex: 1; min-width: 0; }
.link-sent-en { font-size: 29rpx; color: #333; line-height: 1.5; word-break: break-word; }
.link-sent-cn { color: #888; font-size: 26rpx; margin-top: 8rpx; }
.link-sent-play {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 64rpx; height: 64rpx; line-height: 64rpx;
  text-align: center;
  background: #e8f8ef;
  color: #07c160;
  border-radius: 50%;
  font-size: 28rpx;
}
