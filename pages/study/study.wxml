<view class="container">
  <view class="card head" wx:if="{{batch}}">
    <view class="head-title">第 {{batch.batchNo}} 批 · {{batch.words.length}} 词</view>
    <view class="head-info">学习日期 {{batch.date}}</view>
  </view>

  <!-- 模式选择 -->
  <block wx:if="{{batch && !mode}}">
    <view class="card">
      <view class="mode-title">选择学习方式</view>
      <view class="mode-btn" bindtap="chooseEn">
        <view class="mode-icon">🔤</view>
        <view class="mode-name">展示英文</view>
        <view class="mode-desc">显示英文单词，点击后出现中文释义，并朗读中文</view>
      </view>
      <view class="mode-btn" bindtap="chooseCn">
        <view class="mode-icon">🈶</view>
        <view class="mode-name">展示中文</view>
        <view class="mode-desc">显示中文释义，点击后出现英文单词，并朗读英文</view>
      </view>
      <view class="mode-btn" bindtap="goSpell">
        <view class="mode-icon">✍️</view>
        <view class="mode-name">默写模式</view>
        <view class="mode-desc">看中文拼写英文，错一个字母整词重打，错词自动回队重拼</view>
      </view>
      <view class="mode-btn" bindtap="goQuiz">
        <view class="mode-icon">⚡</view>
        <view class="mode-name">当日快测</view>
        <view class="mode-desc">刚学的词马上自测一遍，忘记的会再来一次（不计入复习）</view>
      </view>
    </view>
  </block>

  <!-- 学习中 -->
  <block wx:if="{{batch && mode}}">
    <view class="card mode-bar">
      <view class="mode-tab {{mode === 'en' ? 'active' : ''}}" bindtap="chooseEn">🔤 展示英文</view>
      <view class="mode-tab {{mode === 'cn' ? 'active' : ''}}" bindtap="chooseCn">🈶 展示中文</view>
    </view>

    <view class="card toolbar">
      <text class="text-muted">已点击 {{revealedCount}} / {{items.length}}</text>
      <view class="toolbar-btns">
        <view class="link-btn" bindtap="revealAll">全部显示</view>
        <view class="link-btn" bindtap="hideAll">重新开始</view>
      </view>
    </view>

    <!-- R16-A 全部翻开后浮现快测引导（软引导，不弹窗） -->
    <view class="quiz-guide" wx:if="{{items.length > 0 && revealedCount === items.length}}" bindtap="goQuiz">
      <text class="quiz-guide-icon">⚡</text>
      <view class="quiz-guide-main">
        <view class="quiz-guide-title">全部翻开了！</view>
        <view class="quiz-guide-sub">快测一遍，把刚学的词记牢</view>
      </view>
      <text class="quiz-guide-go">▸</text>
    </view>

    <view class="card list">
      <view class="study-item" wx:for="{{items}}" wx:key="w" data-idx="{{index}}" bindtap="tapWord">
        <text class="study-idx">{{index + 1}}</text>
        <view class="study-main">
          <block wx:if="{{mode === 'en'}}">
            <view class="study-front">{{item.w}}</view>
            <view class="study-phonetic" wx:if="{{item.p}}">{{item.p}}</view>
            <view class="study-back" wx:if="{{item.revealed}}">🔊 {{item.m}}</view>
            <view class="study-hint" wx:else>点击显示中文并朗读</view>
          </block>
          <block wx:else>
            <view class="study-front cn">{{item.m}}</view>
            <view class="study-back" wx:if="{{item.revealed}}">🔊 {{item.w}}<text wx:if="{{item.p}}" class="study-phonetic-inline"> {{item.p}}</text></view>
            <view class="study-hint" wx:else>点击显示英文并朗读</view>
          </block>
        </view>
        <view class="study-acts">
          <view class="act-btn" catchtap="speakWord" data-idx="{{index}}">🔊</view>
          <view class="act-btn txt" catchtap="openLink" data-idx="{{index}}">拓展</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 拓展弹层（R10）：衍生词 / 近义词 / 双语例句 -->
  <view class="link-mask" wx:if="{{linkShow}}" bindtap="closeLink"></view>
  <view class="link-sheet" wx:if="{{linkShow}}">
    <view class="link-head">
      <view class="link-word" catchtap="speakLinkWord">{{link.w}}</view>
      <view class="link-phon" wx:if="{{link.p}}">{{link.p}}</view>
      <view class="link-close" catchtap="closeLink">✕</view>
    </view>

    <view class="link-body" wx:if="{{link.ok}}">
      <view class="link-sec" wx:if="{{link.rels.length > 0}}">
        <view class="link-sec-title">🌱 衍生词（同根词）</view>
        <view class="link-group" wx:for="{{link.rels}}" wx:for-item="grp" wx:key="pos">
          <view class="link-group-pos">{{grp.pos}}</view>
          <view class="link-rel" wx:for="{{grp.words}}" wx:for-item="d" wx:key="w">
            <text class="link-rel-w">{{d.w}}</text>
            <text class="link-rel-m" wx:if="{{d.m}}">{{d.m}}</text>
          </view>
        </view>
      </view>

      <view class="link-sec" wx:if="{{link.synos.length > 0}}">
        <view class="link-sec-title">🔁 近义词</view>
        <view class="link-group" wx:for="{{link.synos}}" wx:for-item="grp" wx:key="pos">
          <view class="link-group-pos">{{grp.pos}} {{grp.tran}}</view>
          <view class="link-syns">
            <text class="link-syn" wx:for="{{grp.ws}}" wx:for-item="s" wx:key="*this">{{s}}</text>
          </view>
        </view>
      </view>

      <view class="link-sec" wx:if="{{link.sents.length > 0}}">
        <view class="link-sec-title">📖 例句（点右侧 🔊 朗读）</view>
        <view class="link-sent" wx:for="{{link.sents}}" wx:for-item="s" wx:key="en">
          <view class="link-sent-main">
            <view class="link-sent-en"><rich-text nodes="{{s.hl}}"></rich-text></view>
            <view class="link-sent-cn">{{s.cn}}</view>
          </view>
          <view class="link-sent-play" catchtap="readSentence" data-en="{{s.en}}">🔊</view>
        </view>
      </view>
    </view>

    <view class="link-body center" wx:elif="{{link.loading}}">
      <view class="link-tip">拓展内容加载中…</view>
    </view>

    <view class="link-body center" wx:else>
      <view class="link-tip">暂无拓展内容（网络不可用或该词暂无数据）</view>
      <view class="link-retry" catchtap="retryLink">重试</view>
    </view>
  </view>
</view>
