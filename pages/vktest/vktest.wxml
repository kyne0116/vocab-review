<view class="container">
  <view class="card">
    <view class="title">VK OCR 识别能力验证（F6）</view>
    <view class="row"><text class="label">基础库版本</text><text>{{sdk || '未知'}}</text></view>
    <view class="row"><text class="label">机型</text><text>{{device || '未知'}}</text></view>
    <view class="row"><text class="label">系统</text><text>{{system || '未知'}}</text></view>
    <view class="row"><text class="label">微信版本</text><text>{{wechat || '未知'}}</text></view>
    <view class="row"><text class="label">isVKSupport('v1')</text><text class="{{v1 ? 'ok' : 'bad'}}">{{v1 === null ? '检测中' : (v1 ? '支持 ✓' : '不支持 ✗')}}</text></view>
    <view class="row"><text class="label">isVKSupport('v2')</text><text class="{{v2 ? 'ok' : 'bad'}}">{{v2 === null ? '检测中' : (v2 ? '支持 ✓' : '不支持 ✗')}}</text></view>
    <view class="row"><text class="label">OCR 综合判定</text><text class="{{vkOk ? 'ok' : 'bad'}}">{{vkOk === null ? '检测中' : (vkOk ? '可识别 ✓' : '不满足 ✗')}}</text></view>
    <view class="tip text-muted">用课本/练习册上的印刷体英文单词实测：拍照或选图后查看能否识别、耗时多少。结果可一键复制回传。</view>
    <button class="btn-primary act-btn" data-source="camera" bindtap="choose" disabled="{{running}}">拍照测试</button>
    <button class="btn-plain act-btn" data-source="album" bindtap="choose" disabled="{{running}}">相册选图测试</button>
  </view>

  <view class="card" wx:if="{{imageSrc}}">
    <image class="preview" src="{{imageSrc}}" mode="aspectFit" />
    <view class="status" wx:if="{{running}}">识别中…</view>
    <block wx:else>
      <view class="status">耗时 {{elapsed}} ms · 识别 {{lines.length}} 行</view>
      <view class="error" wx:if="{{error}}">错误：{{error}}</view>
      <view class="line" wx:for="{{lines}}" wx:key="index">{{item}}</view>
      <button class="btn-plain act-btn" bindtap="copyResult" wx:if="{{!running}}">复制验证结果</button>
    </block>
  </view>
</view>
