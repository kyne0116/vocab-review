.title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.label { color: #999; }
.ok { color: #07c160; font-weight: bold; }
.bad { color: #e64340; font-weight: bold; }
.tip { margin: 16rpx 0; }

.act-btn { margin-top: 24rpx; }

.preview {
  width: 100%;
  height: 500rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.status {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #576b95;
}
.error {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #e64340;
}
.line {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  word-break: break-all;
}
.line:last-of-type { border-bottom: none; }
