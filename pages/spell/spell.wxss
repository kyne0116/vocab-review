/* 默写模式页（R13） */
.spell-card { text-align: center; padding: 60rpx 30rpx; margin-bottom: 30rpx; }
.spell-progress { margin-bottom: 36rpx; }
.spell-meaning {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  word-break: break-word;
}
.spell-hint { color: #576b95; font-size: 26rpx; margin-top: 24rpx; }

.spell-slots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 56rpx;
}
.slot {
  width: 56rpx;
  height: 72rpx;
  margin: 0 6rpx 16rpx;
  border-bottom: 6rpx solid #d8dee4;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.slot.gap { border-bottom-color: transparent; }
.slot.cur { border-bottom-color: #07c160; }
.slot.on {
  background: #e8f8ef;
  border-bottom-color: #07c160;
}
.spell-slots.shake { animation: spellShake .4s ease-in-out; }
@keyframes spellShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-14rpx); }
  75% { transform: translateX(14rpx); }
}

.spell-card.flash-ok {
  background: #f2fbf6;
  box-shadow: inset 0 0 0 6rpx #07c160, 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  animation: spellPop .32s cubic-bezier(.34, 1.56, .64, 1);
}
.spell-card.flash-no {
  background: #fff6f5;
  box-shadow: inset 0 0 0 6rpx #e64340, 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
@keyframes spellPop {
  0% { transform: scale(.96); }
  60% { transform: scale(1.03); }
  100% { transform: scale(1); }
}
.spell-fb { margin-top: 40rpx; font-size: 44rpx; font-weight: 800; }
.spell-fb.ok { color: #07c160; }
.spell-fb.no { color: #e64340; }

.spell-input {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 34rpx;
  text-align: center;
  height: 96rpx;
  box-sizing: border-box;
}
.spell-ph { color: #ccc; }
.spell-tip { text-align: center; margin-top: 20rpx; }

/* 完成页 */
.spell-done { text-align: center; padding: 60rpx 30rpx; }
.done-icon { font-size: 96rpx; animation: spellPop .5s cubic-bezier(.34, 1.56, .64, 1); }
.done-title { font-size: 38rpx; font-weight: bold; margin: 20rpx 0 30rpx; }
.done-row { font-size: 30rpx; margin-top: 14rpx; }
.done-row.ok { color: #07c160; font-weight: 600; }
.done-note { margin-top: 30rpx; }
.done-btn { margin-top: 30rpx; }
