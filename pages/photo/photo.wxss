.intro-title {
  font-size: 38rpx;
  font-weight: bold;
}
.intro-tip { margin-top: 10rpx; }

.center { text-align: center; padding: 60rpx 30rpx; }
.preview {
  width: 100%;
  height: 500rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.loading-text { margin-top: 24rpx; }

.act-btn { margin-top: 24rpx; }
.unsupport-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #e64340;
  margin-bottom: 10rpx;
}
.vktest-link {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin-top: 40rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
}
.hint { margin: 10rpx 0 20rpx; }

/* 候选词行：known=内置命中（R04 标灰禁选） */
.cand {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.cand:last-child { border-bottom: none; }
.cand.known { opacity: 0.45; }
.cand-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 20rpx;
  text-align: center;
  line-height: 40rpx;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
}
.cand-check.on { background: #07c160; border-color: #07c160; }
.cand-word { font-size: 32rpx; }
.cand-tag {
  margin-left: auto;
  background: #f0f0f0;
  color: #999;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.big-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #07c160;
}
.progress-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  margin-top: 30rpx;
  overflow: hidden;
}
.progress-fill { height: 100%; background: #07c160; border-radius: 10rpx; transition: width 0.2s; }

/* 查义结果行 */
.entry { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.entry:last-child { border-bottom: none; }
.entry-head {
  display: flex;
  align-items: baseline;
}
.entry-word { font-size: 34rpx; font-weight: bold; }
.entry-phonic {
  margin-left: 16rpx;
  color: #576b95;
  font-size: 26rpx;
}
.entry-m { margin-top: 8rpx; font-size: 28rpx; color: #333; }
.fail-row { display: flex; align-items: center; gap: 24rpx; }
.link { color: #576b95; font-size: 26rpx; }
.pending-tip { text-align: center; margin-top: 4rpx; }

.done-icon { font-size: 90rpx; }
.done-title {
  font-size: 40rpx;
  font-weight: bold;
  margin: 20rpx 0 10rpx;
}
