.intro-title {
  font-size: 38rpx;
  font-weight: bold;
}
.intro-tip { margin-top: 10rpx; }

.center { text-align: center; padding: 60rpx 30rpx; }
.preview {
  width: 100%;
  height: 500rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.loading-text { margin-top: 24rpx; }

.act-btn { margin-top: 24rpx; }
.unsupport-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #e64340;
  margin-bottom: 10rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
}
.hint { margin: 10rpx 0 20rpx; }

/* 候选页粘连串提示：识别到超长连串文字（>16 字母，已被过滤）时提醒结果可能不完整 */
.glue-tip {
  background: #fff7e6;
  color: #e64340;
  font-size: 26rpx;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 候选词行：known=内置命中（R04 标灰禁选） */
.cand {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.cand:last-child { border-bottom: none; }
.cand.known { opacity: 0.45; }
.cand-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 20rpx;
  text-align: center;
  line-height: 40rpx;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
}
.cand-check.on { background: #07c160; border-color: #07c160; }
.cand-word { font-size: 32rpx; }
/* 候选行主体：词 + AI 自评注记子行（R06-A①） */
.cand-main { flex: 1; min-width: 0; }
.cand-note { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.cand-tag {
  margin-left: auto;
  background: #f0f0f0;
  color: #999;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
/* 候选行右侧「修改」（R08③ 2026-10-02 前移自查义结果页） */
.cand-edit {
  color: #e64340;
  font-size: 26rpx;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.big-num {
  font-size: 72rpx;
  font-weight: bold;
  color: #07c160;
}
.progress-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  margin-top: 30rpx;
  overflow: hidden;
}
.progress-fill { height: 100%; background: #07c160; border-radius: 10rpx; transition: width 0.2s; }

/* 查义结果行：左侧词+释义，右侧红色「修改」（R08 点按改词并自动重查） */
.entry {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.entry:last-child { border-bottom: none; }
.entry-main { flex: 1; min-width: 0; }
.entry-head {
  display: flex;
  align-items: baseline;
}
.entry-word { font-size: 34rpx; font-weight: bold; }
.entry-phonic {
  margin-left: 16rpx;
  color: #576b95;
  font-size: 26rpx;
}
.entry-m { margin-top: 8rpx; font-size: 28rpx; color: #333; }
.fail-row { display: flex; align-items: center; gap: 24rpx; }
.link { color: #576b95; font-size: 26rpx; }
/* R06：AUTO_FIX 自动拉取的 AI 纠错建议（仅展示，点「改用」生效） */
.fix-sug { margin-top: 8rpx; font-size: 24rpx; color: #576b95; }
.pending-tip { text-align: center; margin-top: 4rpx; }

.done-icon { font-size: 90rpx; }
.done-title {
  font-size: 40rpx;
  font-weight: bold;
  margin: 20rpx 0 10rpx;
}