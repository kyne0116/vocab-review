<view class="container">

  <!-- 任务看板：今天没有到期任务时的状态页 -->
  <view wx:if="{{state === 'empty'}}">
    <view class="card board-head">
      <view class="board-title">🔁 今日复习</view>
      <view class="board-streak" wx:if="{{streak > 0}}">🔥 连续学习 {{streak}} 天</view>
    </view>

    <view class="card board-card">
      <view class="board-line ok">✅ 今天没有到期的任务</view>
      <view class="hr"></view>
      <view class="board-row" wx:if="{{lastReview}}">
        <text class="k">上次复习</text>
        <text class="v">{{lastReview.date}} · 第{{lastReview.batchNo}}批 · {{lastReview.total}}词 · 错{{lastReview.wrong}}</text>
      </view>
      <view class="board-row" wx:if="{{!lastReview}}">
        <text class="k">上次复习</text>
        <text class="v">还没有复习记录</text>
      </view>
      <view class="board-row">
        <text class="k">错词本</text>
        <text class="v">{{wrongCount}} 词待巩固</text>
      </view>
      <view class="board-row" wx:if="{{nextDue}}">
        <text class="k">下次任务</text>
        <text class="v">第{{nextDue.batchNo}}批 · {{nextDue.days}}天后（{{nextDue.date}}）</text>
      </view>
      <view class="board-row" wx:if="{{!nextDue}}">
        <text class="k">下次任务</text>
        <text class="v">已全部安排完 🎉</text>
      </view>
      <view class="hr"></view>
      <view class="board-note text-muted">复习节点：学后第 1、2、3、4、6、8、11、13、16、21 天</view>
    </view>

    <!-- 打卡日历（R11）：学习/复习过的日期点亮 -->
    <view class="card cal-card">
      <view class="cal-head">
        <view class="cal-nav" bindtap="calPrev">‹</view>
        <view class="cal-title">{{calYear}}年{{calMonth}}月</view>
        <view class="cal-nav" bindtap="calNext">›</view>
      </view>
      <view class="cal-week">
        <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
      </view>
      <view class="cal-grid">
        <view class="cal-cell {{c.cls}}" wx:for="{{calCells}}" wx:key="index">
          <text wx:if="{{c.d}}">{{c.d}}</text>
        </view>
      </view>
      <view class="cal-note text-muted">打卡 = 当天完成学习或复习 · 坚持点亮可涨 🔥</view>
    </view>

    <view class="board-actions">
      <button wx:if="{{wrongCount > 0}}" class="btn-primary action" bindtap="goFree">复习错词本 {{wrongCount}} 词</button>
      <button wx:else class="btn-plain action">错词本已清空 👍</button>
      <button wx:if="{{nextDue}}" class="btn-plain action" bindtap="goNextDue">提前复习第 {{nextDue.batchNo}} 批</button>
    </view>
  </view>

  <!-- 手动复习：该批不存在 -->
  <view wx:elif="{{state === 'noBatch'}}" class="card empty">
    <view class="empty-icon">🤔</view>
    <view>找不到这一批</view>
    <view class="text-muted" style="margin-top:12rpx;">该批可能已被清空</view>
    <button class="btn-primary" style="margin-top:30rpx;" bindtap="goBack">返回</button>
  </view>

  <!-- 手动复习：该批无待复习词 -->
  <view wx:elif="{{state === 'manualEmpty'}}" class="card empty">
    <view class="empty-icon">👍</view>
    <view>本批没有待复习的词</view>
    <view class="text-muted" style="margin-top:12rpx;">之前的复习没有答错的词（遗忘池为空），无需再复习</view>
    <button class="btn-primary" style="margin-top:30rpx;" bindtap="goBack">返回</button>
  </view>

  <!-- 手动复习：该批已全部完成 -->
  <view wx:elif="{{state === 'manualDone'}}" class="card empty">
    <view class="empty-icon">🎉</view>
    <view>本批已完成全部 10 次复习</view>
    <view class="text-muted" style="margin-top:12rpx;">可用「重学」巩固，或从总览选其他批次</view>
    <button class="btn-primary" style="margin-top:30rpx;" bindtap="goBack">返回</button>
  </view>

  <!-- 自由复习：错词本为空 -->
  <view wx:elif="{{state === 'freeEmpty'}}" class="card empty">
    <view class="empty-icon">👏</view>
    <view>错词本已清空</view>
    <view class="text-muted" style="margin-top:12rpx;">没有需要巩固的单词，继续保持！</view>
    <button class="btn-primary" style="margin-top:30rpx;" bindtap="goBack">返回</button>
  </view>

  <!-- 遗忘池为空，本轮自动完成 -->
  <view wx:elif="{{state === 'autoDone'}}" class="card empty">
    <view class="empty-icon">👍</view>
    <view>本周期的遗忘词为空，已自动完成</view>
    <view class="text-muted" style="margin-top:12rpx;">前几轮没有答错的单词，无需复习</view>
  </view>

  <!-- 复习进行中 -->
  <block wx:elif="{{state === 'quiz'}}">
    <!-- R17 视图切换：卡片（逐词）| 列表（整单通览）；快测固定卡片不显示 -->
    <view class="view-toggle" wx:if="{{mode !== 'study'}}">
      <view class="vt-btn {{view === 'card' ? 'on' : ''}}" bindtap="switchView" data-v="card">🃏 卡片</view>
      <view class="vt-btn {{view === 'list' ? 'on' : ''}}" bindtap="switchView" data-v="list">📋 列表</view>
    </view>

    <!-- 卡片视图（原有流程） -->
    <block wx:if="{{view === 'card'}}">
      <view class="progress-bar">
        <view class="progress-inner" style="width: {{progress}}%;"></view>
      </view>
      <view class="progress-text text-muted">
        <block wx:if="{{mode === 'free'}}">{{index + 1}} / {{items.length}} · 错词本自由复习 · 答对自动移出</block>
        <block wx:elif="{{mode === 'study'}}">{{index + 1}} / {{items.length}} · 第 {{current.batchNo}} 批 · 当日快测 · 忘记的词会再来一遍</block>
        <block wx:else>{{index + 1}} / {{items.length}} · 第 {{current.batchNo}} 批 · 第 {{roundOf(current.batchNo)}} 次复习</block>
      </view>

      <view class="card quiz-card {{feedback === 'ok' ? 'fb-ok' : ''}} {{feedback === 'no' ? 'fb-no' : ''}}">
        <view class="quiz-word" bindtap="readCurrent">{{current.word}}</view>
        <view class="quiz-phonetic" wx:if="{{current.phonetic}}">{{current.phonetic}}</view>

        <view wx:if="{{revealed}}" class="quiz-meaning">{{current.meaning}}</view>
        <view wx:else class="quiz-hint" bindtap="onReveal">点击查看释义</view>
        <view wx:if="{{revealed}}" class="quiz-ext" catchtap="openQuizLink">🌱 拓展：衍生词 · 近义词 · 例句</view>
        <view wx:if="{{feedback === 'ok'}}" class="quiz-fb ok">✓ 记住了！{{petEmoji}}</view>
        <view wx:elif="{{feedback === 'no'}}" class="quiz-fb no">✗ 没关系，再记一次</view>
      </view>

      <button wx:if="{{!revealed}}" class="btn-primary" bindtap="onReveal">显示释义</button>

      <view wx:else class="judge">
        <button class="judge-btn remember {{feedback ? 'dim' : ''}}" bindtap="onRemember">✓ 记得</button>
        <button class="judge-btn forget {{feedback ? 'dim' : ''}}" bindtap="onForget">✗ 忘记了</button>
      </view>
    </block>

    <!-- 列表视图（R17）：词单通览，自控节奏，标忘提交 -->
    <block wx:else>
      <view class="progress-text text-muted">
        <block wx:if="{{mode === 'free'}}">错词本自由复习 · 答对自动移出</block>
        <block wx:elif="{{mode === 'manual'}}">第 {{items[0].batchNo}} 批 · 第 {{roundOf(items[0].batchNo)}} 次复习</block>
        <block wx:else>今日到期复习</block>
        · 共 {{items.length}} 词 · 已看 {{revealedCount}} · 忘记 {{forgotCount}}
      </view>

      <view class="card list-card">
        <view class="rv-row {{listRevealed[item.word] ? 'seen' : ''}}" wx:for="{{items}}" wx:key="word">
          <view class="rv-main" bindtap="tapListWord" data-w="{{item.word}}">
            <view class="rv-head">
              <view class="rv-word">{{item.word}}</view>
              <view class="rv-phonic" wx:if="{{item.phonetic}}">[{{item.phonetic}}]</view>
            </view>
            <view class="rv-mean" wx:if="{{listRevealed[item.word]}}">{{item.meaning}}</view>
            <view class="rv-hint" wx:else>点词看释义</view>
          </view>
          <view class="rv-link" catchtap="openListLink" data-w="{{item.word}}">🌱</view>
          <view class="rv-mark {{forgotMap[item.word] ? 'on' : ''}}" catchtap="toggleListForgot" data-w="{{item.word}}">✕</view>
        </view>
      </view>

      <view class="list-note text-muted">点单词看释义并朗读 · 看过释义后点 🌱 查拓展 · 圆圈标记忘记的词（不标 = 记得）</view>
      <button class="btn-primary" bindtap="finishList">完成复习{{forgotCount > 0 ? '（忘 ' + forgotCount + ' 词）' : ''}}</button>
    </block>
  </block>

  <!-- 复习完成 -->
  <block wx:elif="{{state === 'result'}}">
    <view class="card result">
      <view class="result-icon">🎊</view>
      <view class="result-title">{{mode === 'free' ? '错词本复习完成' : (mode === 'study' ? '本批快测完成' : (mode === 'manual' ? '本批复习完成' : '今日复习完成'))}}</view>
      <block wx:if="{{mode === 'study'}}">
        <view class="result-row">本批单词：{{studyTotal}} 个</view>
        <view class="result-row remember">一次记得：{{firstPass}} 个</view>
        <view class="result-row forget" wx:if="{{studyTotal - firstPass > 0}}">多记一遍才记住：{{studyTotal - firstPass}} 个</view>
        <view class="result-note text-muted">快测只作当天巩固，不计入复习进度；忘记的词明天第 1 次复习还会再见面</view>
      </block>
      <block wx:else>
        <view class="result-row">复习单词：{{items.length}} 个</view>
        <view class="result-row remember">记得：{{remembered}} 个</view>
        <view class="result-row forget">忘记：{{forgot}} 个</view>
        <view class="result-note text-muted" wx:if="{{mode === 'free'}}">答对的词已自动移出错词本；忘记的词保留待巩固</view>
        <view class="result-note text-muted" wx:else>涉及批次：{{batchNos}}</view>
      </block>
    </view>
    <block wx:if="{{mode === 'study'}}">
      <button class="btn-primary" bindtap="restartStudy">再测一遍</button>
      <button class="btn-plain" style="margin-top:20rpx;" bindtap="goBack">返回</button>
    </block>
    <button wx:else class="btn-primary" bindtap="goBack">返回首页</button>
  </block>

  <!-- 拓展弹层（R10）：衍生词 / 近义词 / 双语例句 -->
  <view class="link-mask" wx:if="{{linkShow}}" bindtap="closeLink"></view>
  <view class="link-sheet" wx:if="{{linkShow}}">
    <view class="link-head">
      <view class="link-word" catchtap="speakLinkWord">{{link.w}}</view>
      <view class="link-phon" wx:if="{{link.p}}">{{link.p}}</view>
      <view class="link-close" catchtap="closeLink">✕</view>
    </view>

    <view class="link-body" wx:if="{{link.ok}}">
      <view class="link-sec" wx:if="{{link.rels.length > 0}}">
        <view class="link-sec-title">🌱 衍生词（同根词）</view>
        <view class="link-group" wx:for="{{link.rels}}" wx:for-item="grp" wx:key="pos">
          <view class="link-group-pos">{{grp.pos}}</view>
          <view class="link-rel" wx:for="{{grp.words}}" wx:for-item="d" wx:key="w">
            <text class="link-rel-w">{{d.w}}</text>
            <text class="link-rel-m" wx:if="{{d.m}}">{{d.m}}</text>
          </view>
        </view>
      </view>

      <view class="link-sec" wx:if="{{link.synos.length > 0}}">
        <view class="link-sec-title">🔁 近义词</view>
        <view class="link-group" wx:for="{{link.synos}}" wx:for-item="grp" wx:key="pos">
          <view class="link-group-pos">{{grp.pos}} {{grp.tran}}</view>
          <view class="link-syns">
            <text class="link-syn" wx:for="{{grp.ws}}" wx:for-item="s" wx:key="*this">{{s}}</text>
          </view>
        </view>
      </view>

      <view class="link-sec" wx:if="{{link.sents.length > 0}}">
        <view class="link-sec-title">📖 例句（点右侧 🔊 朗读）</view>
        <view class="link-sent" wx:for="{{link.sents}}" wx:for-item="s" wx:key="en">
          <view class="link-sent-main">
            <view class="link-sent-en"><rich-text nodes="{{s.hl}}"></rich-text></view>
            <view class="link-sent-cn">{{s.cn}}</view>
          </view>
          <view class="link-sent-play" catchtap="readSentence" data-en="{{s.en}}">🔊</view>
        </view>
      </view>
    </view>

    <view class="link-body center" wx:elif="{{link.loading}}">
      <view class="link-tip">拓展内容加载中…</view>
    </view>

    <view class="link-body center" wx:else>
      <view class="link-tip">暂无拓展内容（网络不可用或该词暂无数据）</view>
      <view class="link-retry" catchtap="retryLink">重试</view>
    </view>
  </view>

</view>