.progress-bar {
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.progress-inner {
  height: 100%;
  background: #07c160;
  transition: width 0.32s ease-out; /* R11：进度条节奏（多邻国 320ms） */
}
.progress-text { text-align: center; margin-bottom: 24rpx; }

/* ---- 任务看板（无到期任务的空态） ---- */
.board-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.board-title { font-size: 36rpx; font-weight: bold; }
.board-streak {
  color: #f59a23;
  font-size: 24rpx;
  font-weight: bold;
  background: #fff7e6;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
.board-card { margin-bottom: 30rpx; }
.board-line.ok {
  color: #07c160;
  font-size: 32rpx;
  font-weight: bold;
  padding: 8rpx 0;
}
.board-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20rpx;
  padding: 14rpx 0;
}
.board-row .k { color: #999; font-size: 26rpx; flex-shrink: 0; }
.board-row .v { color: #333; font-size: 26rpx; text-align: right; }
.hr { height: 2rpx; background: #f0f0f0; margin: 16rpx 0; }
.board-note { margin-top: 8rpx; }
.board-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.board-actions .action { width: 100%; }

.quiz-card {
  text-align: center;
  padding: 80rpx 30rpx;
  margin-bottom: 30rpx;
}
.quiz-word { font-size: 64rpx; font-weight: bold; }
.quiz-phonetic { color: #999; margin-top: 16rpx; font-size: 28rpx; }
.quiz-hint { color: #576b95; margin-top: 50rpx; font-size: 28rpx; }
.quiz-meaning {
  margin-top: 50rpx;
  font-size: 36rpx;
  color: #07c160;
  font-weight: bold;
}
.quiz-ext {
  margin-top: 36rpx;
  color: #576b95;
  font-size: 26rpx;
}

/* ---- 拓展弹层（R10）：半屏底部弹层 ---- */
.link-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 90;
}
.link-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 91;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}
.link-head {
  display: flex;
  align-items: baseline;
  padding: 28rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f2f2f2;
  position: relative;
}
.link-word { font-size: 40rpx; font-weight: 600; color: #333; }
.link-phon { color: #999; font-size: 26rpx; margin-left: 16rpx; }
.link-close {
  position: absolute;
  right: 24rpx; top: 24rpx;
  color: #999;
  font-size: 32rpx;
  padding: 6rpx 10rpx;
}
.link-body { overflow-y: scroll; padding: 6rpx 30rpx 40rpx; }
.link-body.center { text-align: center; padding: 70rpx 30rpx; }
.link-tip { color: #999; font-size: 28rpx; }
.link-retry { color: #07c160; font-size: 28rpx; margin-top: 24rpx; }
.link-sec { margin-top: 28rpx; }
.link-sec-title { font-size: 28rpx; font-weight: 600; color: #07c160; margin-bottom: 14rpx; }
.link-group { margin-bottom: 18rpx; }
.link-group-pos { color: #999; font-size: 24rpx; margin-bottom: 10rpx; }
.link-rel { display: flex; margin-bottom: 10rpx; }
.link-rel-w { color: #333; font-weight: 600; font-size: 28rpx; margin-right: 16rpx; flex-shrink: 0; }
.link-rel-m { color: #666; font-size: 26rpx; flex: 1; }
.link-syns { display: flex; flex-wrap: wrap; }
.link-syn {
  background: #f2f6f9;
  color: #444;
  border-radius: 10rpx;
  padding: 8rpx 20rpx;
  font-size: 27rpx;
  margin: 0 14rpx 14rpx 0;
}
.link-sent {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx dashed #f0f0f0;
}
.link-sent:last-child { border-bottom: none; }
.link-sent-main { flex: 1; min-width: 0; }
.link-sent-en { font-size: 29rpx; color: #333; line-height: 1.5; word-break: break-word; }
.link-sent-cn { color: #888; font-size: 26rpx; margin-top: 8rpx; }
.link-sent-play {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 64rpx; height: 64rpx; line-height: 64rpx;
  text-align: center;
  background: #e8f8ef;
  color: #07c160;
  border-radius: 50%;
  font-size: 28rpx;
}

.judge { display: flex; gap: 24rpx; margin-bottom: 10rpx; }
.judge-btn {
  flex: 1;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: none;
  transition: transform .18s, box-shadow .18s;
}
/* R11 厚底按钮：深色底边模拟 3D 凸起，按下位移 + 底边消失 */
.judge-btn.remember { background: #07c160; box-shadow: 0 8rpx 0 #06ad56; }
.judge-btn.forget { background: #e64340; box-shadow: 0 8rpx 0 #c83733; }
.judge-btn:active { transform: translateY(8rpx); box-shadow: 0 0 0 rgba(0, 0, 0, 0); }
.judge-btn.dim { opacity: .45; pointer-events: none; }

/* R11 答题即时反馈：卡片描边闪烁 + 大字鼓励 + 回弹/抖动 */
.quiz-card.fb-ok {
  background: #f2fbf6;
  box-shadow: inset 0 0 0 6rpx #07c160, 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  animation: fbPop .32s cubic-bezier(.34, 1.56, .64, 1);
}
.quiz-card.fb-no {
  background: #fff6f5;
  box-shadow: inset 0 0 0 6rpx #e64340, 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  animation: fbShake .4s ease-in-out;
}
.quiz-fb {
  margin-top: 36rpx;
  font-size: 46rpx;
  font-weight: 800;
  animation: fbPop .32s cubic-bezier(.34, 1.56, .64, 1);
}
.quiz-fb.ok { color: #07c160; }
.quiz-fb.no { color: #e64340; }
@keyframes fbPop {
  0% { transform: scale(.92); }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); }
}
@keyframes fbShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-12rpx); }
  75% { transform: translateX(12rpx); }
}

/* ---- 打卡日历（R11） ---- */
.cal-card { margin-bottom: 30rpx; }
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.cal-title { font-size: 30rpx; font-weight: 600; }
.cal-nav { color: #07c160; font-size: 40rpx; line-height: 1; padding: 6rpx 24rpx; }
.cal-week { display: flex; margin-bottom: 10rpx; }
.cal-week text { flex: 1; text-align: center; color: #999; font-size: 24rpx; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-sizing: border-box;
}
.cal-cell text {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #666;
}
.cal-cell.blank { visibility: hidden; }
.cal-cell.future text { color: #ccc; }
.cal-cell.today text { color: #07c160; font-weight: 600; box-shadow: 0 0 0 3rpx #9fe8bd; }
.cal-cell.fill text { background: #07c160; color: #fff; font-weight: 600; box-shadow: 0 4rpx 0 #06ad56; }
.cal-cell.fill.today text { box-shadow: 0 0 0 3rpx #9fe8bd, 0 4rpx 0 #06ad56; }
.cal-note { margin-top: 8rpx; text-align: center; }

.empty { text-align: center; padding: 80rpx 30rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }

.result { text-align: center; padding: 60rpx 30rpx; margin-bottom: 30rpx; }
.result-icon { font-size: 80rpx; animation: fbPop .5s cubic-bezier(.34, 1.56, .64, 1); }
.result-title { font-size: 38rpx; font-weight: bold; margin: 20rpx 0 30rpx; }
.result-row { font-size: 30rpx; margin-top: 14rpx; }
.result-row.remember { color: #07c160; }
.result-row.forget { color: #e64340; }
.result-note { margin-top: 30rpx; }
