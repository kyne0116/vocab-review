.batch { margin-bottom: 24rpx; }
.batch-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.batch-title { font-size: 32rpx; font-weight: bold; margin-bottom: 8rpx; }
.batch-right { text-align: right; }
.badge {
  display: inline-block;
  background: #f0f9eb;
  color: #07c160;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}
.badge.done { background: #eee; color: #999; }
.study-link {
  display: inline-block;
  background: #07c160;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-top: 10rpx;
}
.toggle-arrow { font-size: 22rpx; color: #bbb; margin-top: 10rpx; }

.hr { height: 1rpx; background: #f0f0f0; margin: 20rpx 0; }

.word-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.word-item .w { font-weight: bold; width: 220rpx; }
.word-item .m { color: #666; flex: 1; text-align: right; }

.rh-title { font-size: 26rpx; font-weight: bold; margin-bottom: 10rpx; }
.rh { font-size: 24rpx; color: #666; padding: 6rpx 0; }

.empty { text-align: center; padding: 80rpx 30rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
