.head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; }
.head-main { flex: 1; min-width: 0; }
.head-title { font-size: 38rpx; font-weight: bold; }
.head-info { margin-top: 12rpx; color: #07c160; font-size: 28rpx; }
.head-range { margin-top: 8rpx; }

.learn-btn {
  color: #e64340;
  font-weight: bold;
  font-size: 26rpx;
  border: 2rpx solid #e64340;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  background: #fff;
}
.learn-btn.stop { color: #fff; background: #e64340; }

/* 播报模式切换：手动点读（默认） / 自动顺读 */
.mode-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #f7f7f7;
  color: #666;
  font-size: 28rpx;
  border: 2rpx solid #eee;
}
.mode-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: bold;
  border-color: #07c160;
}
.manual-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 16rpx;
}

.auto-tip {
  font-size: 24rpx;
  color: #e64340;
  text-align: center;
  margin-bottom: 16rpx;
}

.list-scroll { height: 60vh; margin-bottom: 20rpx; }
.list { padding: 10rpx 30rpx; }
.word-item {
  display: flex;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.word-item:last-child { border-bottom: none; }
.word-item:active { background: #fafafa; }
.word-item.learning { background: #f0faf4; box-shadow: inset 3rpx 0 0 #07c160; }
.word-idx {
  width: 70rpx;
  color: #bbb;
  font-size: 24rpx;
}
.word-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.word-text { font-size: 32rpx; font-weight: bold; }
.word-phonetic { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.word-meaning { color: #555; font-size: 26rpx; }

.done-btn { margin-top: 30rpx; }

.empty { text-align: center; padding: 80rpx 30rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
